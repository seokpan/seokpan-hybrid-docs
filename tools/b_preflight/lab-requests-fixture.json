[
  {
    "kind": "Deployment",
    "metadata": {
      "name": "backend",
      "namespace": "seokpan-argotest"
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      },
      "template": {
        "spec": {
          "containers": [
            {
              "name": "backend",
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              }
            }
          ]
        }
      }
    }
  },
  {
    "kind": "Deployment",
    "metadata": {
      "name": "frontend",
      "namespace": "seokpan-argotest"
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      },
      "template": {
        "spec": {
          "containers": [
            {
              "name": "frontend",
              "resources": {
                "limits": {
                  "cpu": "250m",
                  "memory": "64Mi"
                },
                "requests": {
                  "cpu": "25m",
                  "memory": "32Mi"
                }
              }
            }
          ]
        }
      }
    }
  }
]
